---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
---

<BaseLayout title={`Pagina non trovata · ${site.name}`}>
  <section class="not-found container">
    <p class="eyebrow">Errore 404</p>
    <h1>Questa pagina <em>non esiste</em></h1>
    <p>L’indirizzo potrebbe essere cambiato o non essere corretto.</p>
    <a class="text-link" href="/">Torna alla pagina iniziale</a>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-block: clamp(4rem, 10vw, 8rem) var(--section-space);
  }

  .not-found h1 {
    font-size: clamp(2.75rem, 7vw, 5rem);
  }

  .not-found p:not(.eyebrow) {
    margin-block: 1.5rem 2.5rem;
  }
</style>
