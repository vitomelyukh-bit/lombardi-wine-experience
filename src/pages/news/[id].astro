---
import { Picture } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedNews } from '../../lib/news';
import { formatDate, isoDate } from '../../lib/format';
import { site } from '../../config/site';

export async function getStaticPaths() {
  const news = await getPublishedNews();
  return news.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { title, date, eventDate, summary, cover, coverAlt } = entry.data;
const { Content } = await render(entry);

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();

// Dati strutturati: un articolo e, se la news annuncia un appuntamento, anche l'evento.
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: title,
      description: summary,
      datePublished: date.toISOString(),
      inLanguage: 'it-IT',
      mainEntityOfPage: pageUrl,
      publisher: { '@id': new URL('#organizzazione', Astro.site).toString() },
    },
    ...(eventDate
      ? [
          {
            '@type': 'Event',
            name: title,
            description: summary,
            startDate: eventDate.toISOString().slice(0, 10),
            eventStatus: 'https://schema.org/EventScheduled',
            url: pageUrl,
            location: { '@id': new URL('#luogo', Astro.site).toString() },
            organizer: { '@id': new URL('#organizzazione', Astro.site).toString() },
          },
        ]
      : []),
  ],
};
---

<BaseLayout
  title={`${title} · ${site.name}`}
  description={summary}
  image={cover}
  imageAlt={coverAlt}
  schema={schema}
>
  <article class="article container">
    <a class="article__back" href="/#news">← News ed eventi</a>

    <header class="article__header">
      <p class="eyebrow">
        {
          eventDate ? (
            <span>
              Evento del <time datetime={isoDate(eventDate)}>{formatDate(eventDate)}</time>
            </span>
          ) : (
            <time datetime={isoDate(date)}>{formatDate(date)}</time>
          )
        }
      </p>
      <h1>{title}</h1>
      <p class="lead">{summary}</p>
    </header>

    {
      cover && (
        <div class="article__cover photo">
          <Picture
            src={cover}
            alt={coverAlt ?? ''}
            widths={[640, 960, 1280, 1920]}
            sizes="(min-width: 80em) 80rem, 100vw"
            formats={['avif', 'webp']}
            loading="eager"
          />
        </div>
      )
    }

    <div class="article__body">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .article {
    padding-block: clamp(2rem, 5vw, 4rem) var(--section-space);
  }

  .article__back {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--vino);
  }

  .article__header {
    max-width: 48rem;
    margin-top: clamp(3rem, 7vw, 5rem);
  }

  .article__header h1 {
    font-size: clamp(2.75rem, 7vw, 5rem);
  }

  .article__header .lead {
    margin-top: 1.5rem;
  }

  .article__cover {
    aspect-ratio: 16 / 9;
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }

  .article__body {
    max-width: 40rem;
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }

  .article__body :global(* + *) {
    margin-top: 1.25em;
  }

  .article__body :global(h2) {
    margin-top: 2em;
    font-size: clamp(1.9rem, 4vw, 2.5rem);
  }
</style>
