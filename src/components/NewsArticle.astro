---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { formatDate, isoDate } from '../lib/format';

// La pagina di una news: titolo, date, foto e testo (nello slot). La usano la pagina vera
// (src/pages/news/[id].astro) e l'anteprima del pannello, che passa la foto come indirizzo.
interface Props {
  title: string;
  date: Date;
  eventDate?: Date;
  summary: string;
  cover?: ImageMetadata | string;
  coverAlt?: string;
}

const { title, date, eventDate, summary, cover, coverAlt } = Astro.props;
---

<article class="article container">
  <a class="article__back" href="/#news">← News ed eventi</a>

  <header class="article__header">
    <p class="eyebrow">
      {
        eventDate ? (
          <span>
            Evento del <time datetime={isoDate(eventDate)}>{formatDate(eventDate)}</time>
          </span>
        ) : (
          <time datetime={isoDate(date)}>{formatDate(date)}</time>
        )
      }
    </p>
    <h1>{title}</h1>
    <p class="lead">{summary}</p>
  </header>

  {
    cover && (
      <div class="article__cover photo">
        {typeof cover === 'string' ? (
          <img src={cover} alt={coverAlt ?? ''} />
        ) : (
          <Picture
            src={cover}
            alt={coverAlt ?? ''}
            widths={[640, 960, 1280, 1920]}
            sizes="(min-width: 80em) 80rem, 100vw"
            formats={['avif', 'webp']}
            loading="eager"
          />
        )}
      </div>
    )
  }

  <div class="article__body">
    <slot />
  </div>
</article>

<style>
  .article {
    padding-block: clamp(2rem, 5vw, 4rem) var(--section-space);
  }

  .article__back {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--vino);
  }

  .article__header {
    max-width: 48rem;
    margin-top: clamp(3rem, 7vw, 5rem);
  }

  .article__header h1 {
    font-size: clamp(2.75rem, 7vw, 5rem);
  }

  .article__header .lead {
    margin-top: 1.5rem;
  }

  .article__cover {
    aspect-ratio: 16 / 9;
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }

  .article__body {
    max-width: 40rem;
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }

  .article__body :global(* + *) {
    margin-top: 1.25em;
  }

  .article__body :global(h2) {
    margin-top: 2em;
    font-size: clamp(1.9rem, 4vw, 2.5rem);
  }
</style>
